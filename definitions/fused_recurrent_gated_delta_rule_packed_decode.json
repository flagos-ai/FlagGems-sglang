{
  "api_version": "v6.0",
  "name": "fused_recurrent_gated_delta_rule_packed_decode",
  "requires_triton_kernel": true,
  "description": "Single-token gated delta-rule decode from packed q, k and v in mixed_qkv. Compute beta as sigmoid(b) rounded through b.dtype and decay as exp(-exp(A_log)*softplus(a+dt_bias)). Optionally L2-normalize q and k and multiply q by scale. Use the selected [HV,V,K] FP32 state slot to compute the output and update the state in place. A slot index <=0 produces zero output and leaves the state unchanged for that row. Write the [B,1,HV,V] caller output and return (out, initial_state), both aliasing their input buffers.",
  "parameters": [
    {
      "name": "mixed_qkv",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "a",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "b",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "A_log",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "dt_bias",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "scale",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "initial_state",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "out",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "ssm_state_indices",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "use_qk_l2norm_in_kernel",
      "kind": "positional_or_keyword",
      "required": false,
      "default": false
    }
  ],
  "outputs": [
    "out",
    "initial_state"
  ],
  "effects": {
    "mutates": [
      "initial_state",
      "out"
    ],
    "returns_alias_of": {
      "out": "out",
      "initial_state": "initial_state"
    }
  }
}
