    {
      "name": "q",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "k",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "v",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "g",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "beta",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "scale",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "initial_state",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "use_qk_l2norm_in_kernel",
      "kind": "positional_or_keyword",
      "required": true
    }
  ],
  "outputs": [
    "output",
    "final_state"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
}
