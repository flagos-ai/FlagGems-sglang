{
  "api_version": "v6.0",
  "name": "fused_recurrent_kda",
  "description": "Run recurrent Kimi Delta Attention. Decay the state per key channel using exp(g), apply the beta-weighted delta update and read out with the scaled query. Optionally L2-normalize queries and keys. Return the token outputs and the updated state without modifying initial_state.",
