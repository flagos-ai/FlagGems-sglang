    {
      "name": "a",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "b",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "num_experts",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "num_tokens_per_expert",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "expert_token_offs",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "expert_block_offs",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "expert_block_schedule",
      "kind": "positional_or_keyword",
      "required": true
    }
  ],
  "outputs": [
    "output"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
}
