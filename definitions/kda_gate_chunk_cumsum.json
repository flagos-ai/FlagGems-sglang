    {
      "name": "g",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "A_log",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "chunk_size",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "scale",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "dt_bias",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "lower_bound",
      "kind": "positional_or_keyword",
      "required": true
    }
  ],
  "outputs": [
    "output"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
}
