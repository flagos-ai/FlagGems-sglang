      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "q_weight",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "k_weight",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "positions",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "cos_sin_cache",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "eps",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "head_dim",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "rotary_dim",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "is_neox_style",
      "kind": "positional_or_keyword",
      "required": true
    }
  ],
  "outputs": [
    "q_out",
    "k_out"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  }
