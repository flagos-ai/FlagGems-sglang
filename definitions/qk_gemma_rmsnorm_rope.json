{
  "api_version": "v6.0",
  "name": "qk_gemma_rmsnorm_rope",
  "requires_triton_kernel": true,
  "description": "Apply Gemma RMSNorm with weights 1+w to each head of q and k independently. Round the normalized values to their input dtype before rotating the first rotary_dim lanes using the cache at positions; retain the normalized tail. is_neox_style selects split-half or even/odd pairs. Return two new tensors with the corresponding q and k shapes and dtypes.",
