+template <bool kUsePDL>
+struct N32K5120Kernel {
+  using Trait1 = N32K5120Trait<1>;
+  static constexpr uint32_t kMaxMSplit = Trait1::kMaxMSplit;
+  using KernelFn = void (*)(N32K5120Params);
+
